<simulation verbosity='high'>
  <output prefix='results/ffdirect'>
    <properties filename='properties' stride='1'>[step, time{femtosecond}, conserved{electronvolt}, potential{electronvolt}]</properties>
    <trajectory filename='trajectory' stride='1' format='xyz'>positions{angstrom}</trajectory>
  </output>
  <total_steps>10</total_steps>
  <prng><seed>31415</seed></prng>
  <ffdirect name='mace_direct' pbc='true'>
    <pes>mace</pes>
    <parameters>{template:init.xyz,model:../mace.model,device:cpu,mace_kwargs:mace_kwargs.json}</parameters>
  </ffdirect>
  <system>
    <initialize nbeads='1'>
      <file mode='ase'>init.xyz</file>
      <velocities mode='manual' units='atomic_unit'>[0, 0, 0, 0, 0, 0, 0, 0, 0]</velocities>
    </initialize>
    <forces><force forcefield='mace_direct'/></forces>
    <motion mode='dynamics'>
      <dynamics mode='nve'>
        <timestep units='femtosecond'>0.5</timestep>
      </dynamics>
    </motion>
  </system>
</simulation>
